# --- Obligatorias (CLAUDE.md §9) ---
DATABASE_URL=postgres://finanzas:finanzas@localhost:5432/finanzas   # solo para dev local; en Docker se arma sola
JWT_SECRET=                 # openssl rand -hex 32
JWT_REFRESH_SECRET=         # openssl rand -hex 32 (distinto al anterior)
GEMINI_API_KEY=             # Google AI Studio; sin ella el Scan responde 503
N8N_WEBHOOK_URL=            # p.ej. https://n8n.tudominio.com/webhook/finanzas ; vacío = no se envía

# --- Despliegue (docker-compose) ---
POSTGRES_PASSWORD=
DOMINIO=finanzas.tudominio.com
TZ=America/Lima
TRAEFIK_NETWORK=traefik
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_CERTRESOLVER=letsencrypt
GEMINI_MODEL=gemini-2.5-flash

# --- Solo para el seed del usuario ---
SEED_EMAIL=
SEED_PASSWORD=
